# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments (uv)
# `.venv/` is disposable — `uv sync` rebuilds it from uv.lock.
# NOT ignored, and must stay that way: `uv.lock` (the resolution) and
# `.python-version` (the interpreter). Together they are what make a fresh
# clone reproduce this environment exactly.
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Vendor IODD / EDS files fetched at runtime into the user cache
.cache/
*.iodd.zip

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
